<div class="content">

  <h3>Reset Password</h3>

  <p>Email: {{email}}</p>

  {{input type="password" value=newPassword placeholder="New Password"}}

  <button {{action "changePassword"}}>Update Password</button>

  {{#if message}}
    <p class="message">{{message}}</p>
  {{/if}}

  {{#if error}}
    <p class="error">{{error}}</p>
  {{/if}}

</div>
